        "@*[text*='关闭'][clickable=true]"
      ],
      "action": "click",
      "actionCd": 1000,
      "priority": 2
    },
    {
      "name": "全局-广告SDK包名",
      "appId": "sigmob",
      "matches": [
        "@*[text*='跳过'][clickable=true]",
        "@*[text*='关闭'][clickable=true]"
      ],
      "action": "click",
      "actionCd": 1000,
      "priority": 2
    },
    {
      "name": "全局-广告SDK包名",
      "appId": "ads",
      "matches": [
        "@*[text*='跳过'][clickable=true]",
        "@*[text*='关闭'][clickable=true]"
      ],
      "action": "click",
      "actionCd": 1000,
      "priority": 1
    }
  ]
}
